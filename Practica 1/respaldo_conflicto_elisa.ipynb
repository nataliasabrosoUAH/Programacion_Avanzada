    "# Ejercicio 2\n",
    "\n",
    "def is_leap_year(year: int) -> bool:\n",
    "    \"\"\"Devuelve True si el año es bisiesto y False si no lo es.\"\"\"\n",
    "    return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\n",
    "\n",
    "def leap_years_between(start: int, end: int) -> list[int]:\n",
    "    \"\"\"Devuelve una lista de los años bisiestos entre start y end incluidos.\"\"\"\n",
    "    leap_years = []\n",
    "    \n",
    "    for year in range(start, end + 1):\n",
    "        if is_leap_year(year):\n",
    "            leap_years.append(year)\n",
    "    return leap_years\n",
    "\n",
    "def explain_leap_year(year: int) -> str:\n",
    "    \"\"\"Indica si el año es bisiesto y explica el motivo.\"\"\"\n",
    "    if year % 400 == 0:\n",
    "        return f\"{year} es un año bisiesto: es divisible entre 400.\"\n",
    "    elif year % 100 == 0:\n",
    "        return f\"{year} no es un año bisiesto: es divisible entre 100 pero no entre 400.\"\n",
    "    elif year % 4 == 0:\n",
    "        return f\"{year} es un año bisiesto: es divisible entre 4 pero no entre 100.\"\n",
    "    else:\n",
    "        return f\"{year} no es un año bisiesto: no es divisible entre 4.\"\n",
    "\n",
    "def main() -> None:\n",
    "    \"\"\"Solicita un año y prueba las funciones del ejercicio.\"\"\"\n",
    "    year = int(input(\"Año: \"))\n",
    "    \n",
    "    if year < 1582:\n",
    "        print(\"El calendario gregoriano se estableció en 1582.\")\n",
    "    else:\n",
    "        print(explain_leap_year(year))\n",
    "        \n",
    "    # Pruebas con los años del enunciado y un caso adicional.\n",
    "    for test_year in [1900, 2000, 2023, 2024, 2100]:\n",
    "        print(test_year, is_leap_year(test_year))\n",
    "        print(explain_leap_year(test_year))\n",
    "    # Pruebas de los intervalos.\n",
    "    print(leap_years_between(1896, 1912))\n",
    "    print(leap_years_between(2020, 2025))\n",
    "    print(leap_years_between(2021, 2023))\n",
    "    \n",
    "main()"
   ]
