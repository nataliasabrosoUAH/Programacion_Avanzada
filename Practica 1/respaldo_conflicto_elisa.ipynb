    "# Ejercicio 8\n",
    "\n",
    "def sum_numbers(numbers: list[int]) -> int:\n",
    "    \"\"\"Devuelve la suma de todos los números de la lista.\"\"\"\n",
    "    total = 0\n",
    "    \n",
    "    for number in numbers:\n",
    "        total += number\n",
    "    return total\n",
    "\n",
    "def sum_positive_negative(numbers: list[int]) -> tuple[int, int]:\n",
    "    \"\"\"Devuelve la suma de los números positivos y negativos de la lista.\"\"\"\n",
    "    positive_sum = 0\n",
    "    negative_sum = 0\n",
    "    \n",
    "    for number in numbers:\n",
    "        if number > 0:\n",
    "            positive_sum += number\n",
    "        elif number < 0:\n",
    "            negative_sum += number\n",
    "            \n",
    "    return positive_sum, negative_sum\n",
    "\n",
    "def find_max_min(numbers: list[int]) -> tuple[int, int] | None:\n",
    "    \"\"\"Devuelve el máximo y el mínimo de la lista, o None si la lista esta vacía.\"\"\"\n",
    "    if not numbers:\n",
    "        return None\n",
    "    \n",
    "    maximum = max(numbers)\n",
    "    minimum = min(numbers)\n",
    "    \n",
    "    return maximum, minimum\n",
    "\n",
    "def all_unique(numbers: list[int]) -> bool:\n",
    "    \"\"\"Devuelve True si no hay números repetidos y False si los hay.\"\"\"\n",
    "    seen = []\n",
    "    \n",
    "    for number in numbers:\n",
    "        if number in seen:\n",
    "            return False\n",
    "        seen.append(number)\n",
    "        \n",
    "    return True\n",
    "\n",
    "def compare_positive_negative(numbers: list[int]) -> str:\n",
    "    \"\"\"Indica si hay más positivos, más negativos o la misma cantidad.\"\"\"\n",
    "    positive_count = 0\n",
    "    negative_count = 0\n",
    "    \n",
    "    for number in numbers:\n",
    "        if number > 0:\n",
    "            positive_count += 1\n",
    "        elif number < 0:\n",
    "            negative_count += 1\n",
    "            \n",
    "    if positive_count == negative_count:\n",
    "        return \"Hay tantos positivos como negativos.\"\n",
    "    \n",
    "    return(\n",
    "        \"Hay más números positivos.\"\n",
    "        if positive_count > negative_count\n",
    "        else \"Hay más números negativos.\"\n",
    "    )\n",
    "    \n",
    "def main() -> None:\n",
    "    \"\"\"Lee una lista de enteros y permite analizarlos mediante un menú.\"\"\"\n",
    "    while True:\n",
    "        text = input(\n",
    "            \"Introduce enteros separados por espacios\"\n",
    "            \"(Enter para una lista vacía): \"\n",
    "        )\n",
    "        \n",
    "        try:\n",
    "            numbers = []\n",
    "            for value in text.split():\n",
    "                numbers.append(int(value))\n",
    "            break\n",
    "        except ValueError:\n",
    "            print(\"Debes introducir solo números enteros separados por espacios.\")\n",
    "    while True:\n",
    "        print(\"\\nLista actual:\", numbers)\n",
    "        print(\"1. Sumar todos los números\")\n",
    "        print(\"2. Sumar positivos y negativos por separado\")\n",
    "        print(\"3. Mostrar máximo y mínimo\")\n",
    "        print(\"4. Comprobar si todos los números son únicos\")\n",
    "        print(\"5. Comparar la cantidad de positivos y negativos\")\n",
    "        print(\"0. Salir\")\n",
    "        \n",
    "        option = input(\"Elige una opción: \").strip()\n",
    "        \n",
    "        if option == \"1\":\n",
    "            print(\"Suma total:\", sum_numbers(numbers))\n",
    "            \n",
    "        elif option == \"2\":\n",
    "            positive_sum, negative_sum = sum_positive_negative(numbers)\n",
    "            print(\"Suma de positivos:\", positive_sum)\n",
    "            print(\"Suma de negativos:\", negative_sum)\n",
    "            \n",
    "        elif option == \"3\":\n",
    "            result = find_max_min(numbers)\n",
    "            \n",
    "            if result is None:\n",
    "                print(\"La lista está vacía: no tiene máximo ni mínimo.\")\n",
    "            else:\n",
    "                maximum, minimum = result\n",
    "                print(\"Maximo:\", maximum)\n",
    "                print(\"Mínimo:\", minimum)\n",
    "                \n",
    "        elif option == \"4\":\n",
    "            if all_unique(numbers):\n",
    "                print(\"Todos los números son unicos.\")\n",
    "            else:\n",
    "                print(\"Hay números repetidos.\")\n",
    "                \n",
    "        elif option == \"5\":\n",
    "            print(compare_positive_negative(numbers))\n",
    "            \n",
    "        elif option == \"0\":\n",
    "            print(\"Programa Terminado.\")\n",
    "            break\n",
    "        else:\n",
    "            print(\"Opción no válida. Elige un número del 0 al 5.\")\n",
    "main()"
   ]
