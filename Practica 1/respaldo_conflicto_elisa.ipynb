    "# Ejercicio 4\n",
    "\n",
    "def shift_char(char: str, shift: int) -> str:\n",
    "    \"\"\"Desplaza una letra inglesa y deja los demás caracteres sin cambios.\"\"\"\n",
    "    if 'a' <= char <= 'z':\n",
    "        base = ord('a')\n",
    "    elif 'A' <= char <= 'Z':\n",
    "        base = ord('A')\n",
    "    else:\n",
    "        return char\n",
    "    \n",
    "    position = ord(char) - base\n",
    "    new_position = (position + shift) % 26\n",
    "\n",
    "    return chr(base + new_position)\n",
    "\n",
    "def encrypt(text: str, shift: int) -> str:\n",
    "    \"\"\"Cifra un texto desplazando cada letra las posiciones indicadas.\"\"\"\n",
    "    encrypted_text = \"\"\n",
    "    \n",
    "    for char in text:\n",
    "        encrypted_text += shift_char(char, shift)\n",
    "        \n",
    "    return encrypted_text\n",
    "\n",
    "def decrypt(text: str, shift: int) -> str:\n",
    "    \"\"\"Descifra un texto utilizando el desplazamiento contrario.\"\"\"\n",
    "    return encrypt(text, -shift)\n",
    "\n",
    "def brute_force(cipher_text: str) -> list[str]:\n",
    "    \"\"\"Devuelve los 26 posibles descifrados del texto.\"\"\"\n",
    "    results = []\n",
    "\n",
    "    for shift in range(26):\n",
    "        results.append(decrypt(cipher_text, shift))\n",
    "\n",
    "    return results\n",
    "\n",
    "def main() -> None:\n",
    "    \"\"\"Prueba las funciones del cifrado César.\"\"\"\n",
    "    # Desplazamiento de una letra.\n",
    "    print(\"Letra b desplazada 3 posiciones:\", shift_char(\"b\", 3))\n",
    "\n",
    "    # Cifrado y descifrado de un texto.\n",
    "    print(\"Texto cifrado:\", encrypt(\"Hola, Mundo!\", 3))\n",
    "    print(\"Texto descifrado:\", decrypt(\"Krod, Pxqgr!\", 3))\n",
    "\n",
    "    # Vuelta al principio del alfabeto y desplazamiento negativo.\n",
    "    print(\"xyz con desplazamiento 3:\", encrypt(\"xyz\", 3))\n",
    "    print(\"abc con desplazamiento -3:\", encrypt(\"abc\", -3))\n",
    "\n",
    "    # Desplazamiento mayor que 26 y caracteres que no cambian.\n",
    "    print(\"abc con desplazamiento 29:\", encrypt(\"abc\", 29))\n",
    "    print(\"Números y signos:\", encrypt(\"123!?\", 3))\n",
    "\n",
    "    # Los 26 posibles descifrados.\n",
    "    print(\"Posibles descifrados:\")\n",
    "    candidates = brute_force(\"Krod, Pxqgr!\")\n",
    "\n",
    "    for shift in range(26):\n",
    "        print(shift, candidates[shift])\n",
    "\n",
    "\n",
    "main()"
   ]
