    "def normalize(text: str) -> str:\n",
    "    \"\"\"Convierte un texto a minúsculas y elimina tildes y caracteres no alfanuméricos.\"\"\"\n",
    "    text = text.lower()\n",
    "\n",
    "    text = text.replace(\"á\", \"a\")\n",
    "    text = text.replace(\"é\", \"e\")\n",
    "    text = text.replace(\"í\", \"i\")\n",
    "    text = text.replace(\"ó\", \"o\")\n",
    "    text = text.replace(\"ú\", \"u\")\n",
    "    text = text.replace(\"ü\", \"u\")\n",
    "\n",
    "    result = \"\"\n",
    "\n",
    "    for char in text:\n",
    "        if char.isalnum():\n",
    "            result += char\n",
    "\n",
    "    return result\n",
    "\n",
    "\n",
    "def is_palindrome(text: str) -> bool:\n",
    "    \"\"\"Comprueba si un texto es un palíndromo.\"\"\"\n",
    "    normalized_text = normalize(text)\n",
    "    reversed_text = normalized_text[::-1]\n",
    "\n",
    "    return normalized_text == reversed_text\n",
    "\n",
    "\n",
    "def find_palindromes(sentences: list[str]) -> list[str]:\n",
    "    \"\"\"Devuelve una lista con las frases que son palíndromos.\"\"\"\n",
    "    palindromes = []\n",
    "\n",
    "    for sentence in sentences:\n",
    "        if is_palindrome(sentence):\n",
    "            palindromes.append(sentence)\n",
    "\n",
    "    return palindromes\n",
    "\n",
    "\n",
    "def palindrome_words(text: str) -> list[str]:\n",
    "    \"\"\"Devuelve las palabras palíndromas de al menos tres letras.\"\"\"\n",
    "    words = text.split()\n",
    "    result = []\n",
    "\n",
    "    for word in words:\n",
    "        if len(word) >= 3:\n",
    "            if is_palindrome(word):\n",
    "                result.append(word)\n",
    "\n",
    "    return result\n",
    "\n",
    "\n",
    "def main() -> None:\n",
    "    \"\"\"Prueba todas las funciones del ejercicio 5.\"\"\"\n",
    "\n",
    "    # Prueba de normalize\n",
    "    print(normalize(\"¡Ánita lava la tina!\"))\n",
    "\n",
    "    # Pruebas de is_palindrome\n",
    "    print(is_palindrome(\"Anita lava la tina\"))\n",
    "    print(is_palindrome(\"Hola mundo\"))\n",
    "\n",
    "    # Prueba de find_palindromes\n",
    "    sentences = [\n",
    "        \"Anita lava la tina\",\n",
    "        \"Dábale arroz a la zorra el abad\",\n",
    "        \"Esto no es un palíndromo\",\n",
    "        \"¿Acaso hubo búhos acá?\"\n",
    "    ]\n",
    "\n",
    "    print(find_palindromes(sentences))\n",
    "\n",
    "    # Prueba de palindrome_words\n",
    "    print(palindrome_words(\"Ana vio un oso en el ojo de Anita\"))\n",
    "\n",
    "    # Pruebas adicionales\n",
    "    print(is_palindrome(\"Reconocer\"))\n",
    "    print(palindrome_words(\"Somos seres\"))\n",
    "\n",
    "\n",
    "main()\n",
    "\n",
    "\n"
   ]
