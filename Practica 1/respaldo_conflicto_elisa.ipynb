    "# Ejercicio 6\n",
    "\n",
    "def is_prime(n: int) -> bool:\n",
    "    \"\"\"Devuelve True si n es primo y False si no lo es.\"\"\"\n",
    "    if n < 2:\n",
    "        return False\n",
    "\n",
    "    for divisor in range(2, n):\n",
    "        if n % divisor == 0:\n",
    "            return False\n",
    "\n",
    "    return True\n",
    "\n",
    "def prime_list(limit: int) -> list[int]:\n",
    "    \"\"\"Devuelve los números primos hasta limit, incluido.\"\"\"\n",
    "    primes = []  # crea una lista vacia\n",
    "\n",
    "    for number in range(2, limit + 1): #recorre los numeros desde 2 hasta el límite. Sumamos 1 porque range no incluye su extremo final.\n",
    "        if is_prime(number):\n",
    "            primes.append(number)\n",
    "\n",
    "    return primes\n",
    "\n",
    "def check_palindrome(primes: list[int]) -> list[int]:\n",
    "    \"\"\"Devuelve los números palíndromos de una lista de primos.\"\"\"\n",
    "    palindromes = []\n",
    "\n",
    "    for prime in primes:\n",
    "        text = str(prime) #convierte el numero en texto \n",
    "        if text == text[::-1]: #obtiene el texto al reves y lo compara con el original\n",
    "            palindromes.append(prime)\n",
    "\n",
    "    return palindromes\n",
    "\n",
    "def categorize_prime(prime: int) -> str:\n",
    "    \"\"\"Clasifica un número primo como pequeño, mediano o grande.\"\"\"\n",
    "    if prime < 10:\n",
    "        return \"pequeño\"\n",
    "    elif prime < 100:\n",
    "        return \"mediano\"\n",
    "    else:\n",
    "        return \"grande\"\n",
    "    \n",
    "def main() -> None:\n",
    "    \"\"\"Prueba las funciones de análisis de números primos.\"\"\"\n",
    "    # Comprobar números primos y no primos.\n",
    "    for number in [-3, 0, 1, 2, 7, 9]:\n",
    "        print(number, \"¿es primo?\", is_prime(number))\n",
    "\n",
    "    # Generar listas con diferentes límites.\n",
    "    for limit in [1, 2, 7, 20]:\n",
    "        print(\"Primos hasta\", limit, \":\", prime_list(limit))\n",
    "\n",
    "    # Buscar palíndromos entre los primos hasta 150.\n",
    "    primes = prime_list(150)\n",
    "    print(\"Primos palíndromos hasta 150:\", check_palindrome(primes))\n",
    "\n",
    "    # Probar las tres categorías.\n",
    "    for prime in [7, 13, 97, 101]:\n",
    "        print(prime, \"es\", categorize_prime(prime))\n",
    "\n",
    "\n",
    "main()"
   ]
