    "def process_text(\n",
    "        text: str=\"This is a default text with Python and amazing words.\",\n",
    "        words: list[str]=[\"Python\",\"amazing\"]\n",
    ")-> tuple [str, int]:\n",
    "    \"\"\"Procesa un texto reemplazando determinadas pallabras por asteriscos.\"\"\"\n",
    "    text=text.lower()\n",
    "    text=text.strip()\n",
    "\n",
    "    text_words =text.split()\n",
    "    count=0\n",
    "    result_words=[]\n",
    "    for word in text_words:\n",
    "        if word in [w.lower() for w in words]:\n",
    "            result_words.append(\"*\" * len(word))\n",
    "            count += 1\n",
    "        else:\n",
    "            result_words.append(word)\n",
    "\n",
    "    processed_text = \" \".join(result_words)\n",
    "    return processed_text, count\n",
    "\n",
    "def main() -> None:\n",
    "    \"\"\"Prueba la función process_text con los valores predeterminados\"\"\"\n",
    "    processed_text, count=process_text()\n",
    "    print(f\"Processed text: \\\"{processed_text}\\\"\")\n",
    "    print(f\"Palabras reemplazadas: {count}\")\n",
    "    texto2, cantidad2 = process_text(\n",
    "        \"Hola PYTHON y python\",\n",
    "        [\"Python\"]\n",
    "    )\n",
    "\n",
    "    print(texto2)\n",
    "    print(cantidad2)\n",
    "main()"
   ]
